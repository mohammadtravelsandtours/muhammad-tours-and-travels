# ── Environment ──────────────────────────────────────────────
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://mohammad:mohammad@localhost:5432/mohammad_travels?schema=public

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=changeme-access-secret-min-32-chars
JWT_REFRESH_SECRET=changeme-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── API ──────────────────────────────────────────────────────
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# ── Object storage (S3-compatible) — Phase 2+, present for completeness ─
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Payments — MANUAL (mock) by default; set both of these to switch a
# real Stripe test-mode account on (see StripePaymentProvider) ─────────
PAYMENT_PROVIDER_STRATEGY=MANUAL
STRIPE_SECRET_KEY=

# ── Multi-currency / FX conversion — OFF by default (see FxRatesService).
# Set FX_RATES_JSON to turn it on with a static table, e.g.:
#   FX_BASE_CURRENCY=USD
#   FX_RATES_JSON={"USD":1,"BDT":110,"EUR":0.92,"GBP":0.79}
# FX_PROVIDER_API_URL/_API_KEY are optional and layer a live provider
# (tried first, falling back to the static table above on any error) —
# see FxRatesService's own doc comment for the expected response shape.
FX_BASE_CURRENCY=USD
FX_RATES_JSON=
FX_PROVIDER_API_URL=
FX_PROVIDER_API_KEY=

# ── WhatsApp (Meta Cloud API) — MOCK (logs only) by default; set all
# three to switch a real WhatsApp Business number on (see
# WhatsAppCloudApiProvider). WHATSAPP_PHONE_NUMBER_ID is the Cloud API
# phone number id from Meta's App Dashboard, not the raw phone number.
WHATSAPP_PROVIDER_STRATEGY=MOCK
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Frontend → API base URLs ─────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Stripe publishable key — set on apps/web and apps/corporate only when
# PAYMENT_PROVIDER_STRATEGY=STRIPE above. Must be the publishable key
# from the SAME Stripe account as STRIPE_SECRET_KEY. Leave blank to keep
# checkout on the default MANUAL provider (no card form is shown).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Hajj & Umrah contact widget (apps/web) — click-to-contact links,
# always shown regardless of the WhatsApp provider above (a wa.me link
# works with or without a Cloud API integration on the backend). Set
# NEXT_PUBLIC_WHATSAPP_NUMBER in international format with no "+" or
# spaces (e.g. 8801700000000), same convention as wa.me links.
NEXT_PUBLIC_WHATSAPP_NUMBER=8801700000000
NEXT_PUBLIC_SUPPORT_PHONE=+8801700000000
NEXT_PUBLIC_SUPPORT_EMAIL=mohammadtravelsandtours@gmail.com

# Public website canonical URL (used by sitemap/robots metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
