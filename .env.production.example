# Copy to .env.production and replace every placeholder before deployment.
NODE_ENV=production

# Public DNS names. Point all five records to the Hostinger VPS IP.
PUBLIC_DOMAIN=muhammadtravels.com
B2B_DOMAIN=b2b.muhammadtravels.com
CORPORATE_DOMAIN=corporate.muhammadtravels.com
ADMIN_DOMAIN=admin.muhammadtravels.com
API_DOMAIN=api.muhammadtravels.com
PUBLIC_API_URL=https://api.muhammadtravels.com/api/v1

POSTGRES_USER=mohammad_prod
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=mohammad_travels

JWT_ACCESS_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_THIS_TO_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

API_PORT=4000
API_CORS_ORIGINS=https://muhammadtravels.com,https://www.muhammadtravels.com,https://b2b.muhammadtravels.com,https://corporate.muhammadtravels.com,https://admin.muhammadtravels.com
WEB_APP_URL=https://muhammadtravels.com
NEXT_PUBLIC_SITE_URL=https://muhammadtravels.com

# Production must use a real payment integration. Do not deploy with the
# project's MANUAL provider; it is a test recorder and does not move money.
PAYMENT_PROVIDER_STRATEGY=STRIPE
WHATSAPP_PROVIDER_STRATEGY=META

# Optional real integrations
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_BASE_URL=https://api.amadeus.com
STRIPE_SECRET_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_MAX_TOKENS=800
AI_MAX_TOOL_ITERATIONS=4
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
FX_BASE_CURRENCY=USD
FX_RATES_JSON=
FX_PROVIDER_API_URL=
FX_PROVIDER_API_KEY=

RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
